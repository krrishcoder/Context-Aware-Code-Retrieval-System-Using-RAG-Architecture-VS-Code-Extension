{
  "name": "krrishcoder07",
  "displayName": "RAGsearch",
  "description": "VS Code extension for context-aware code search and modification using RAG architecture.",
  "publisher": "krrishcoder07",
  "icon": "spider.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/krrishcoder/Context-Aware-Code-Retrieval-System-Using-RAG-Architecture-VS-Code-Extension"
  },
  "version": "2.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:krrishcoder.searchCode",
    "onCommand:krrishcoder.openChat",
    "onView:krrishcoder.actions"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "krrishcoder.searchCode",
        "title": "RAG Search: Context-Aware Code Search",
        "icon": "$(search)"
      },
      {
        "command": "krrishcoder.rebuildIndex",
        "title": "RAG: Rebuild Index",
        "icon": "$(refresh)"
      },
      {
        "command": "krrishcoder.openChat",
        "title": "RAG Chat: Ask code questions",
        "icon": "$(comment-discussion)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "krrishcoder",
          "title": "RAG Search",
          "icon": "media/spider.svg"
        }
      ]
    },
    "views": {
      "krrishcoder": [
        {
          "id": "krrishcoder.actions",
          "name": "Code Retrieval"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "krrishcoder.openChat",
          "group": "navigation@10"
        }
      ],
      "view/title": [
        {
          "command": "krrishcoder.openChat",
          "when": "view == krrishcoder.actions",
          "group": "navigation@1"
        },
        {
          "command": "krrishcoder.searchCode",
          "when": "view == krrishcoder.actions",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.34.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
